{
  "name": "agent-studio",
  "version": "1.2.0",
  "private": true,
  "description": "Design, validate and export Microsoft 365 Copilot declarative agents — no backend required.",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build": "node scripts/build-single.mjs",
    "screenshots": "node tests/screenshots.mjs",
    "e2e": "npm run build && node tests/screenshots.mjs",
    "vendor": "node scripts/vendor-ajv.mjs",
    "example": "node scripts/make-example.mjs",
    "release": "npm run build && npm run example && node scripts/package-release.mjs"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "axe-core": "^4.14.0",
    "esbuild": "^0.25.0",
    "jszip": "^3.10.1",
    "playwright-core": "^1.63.0"
  },
  "allowScripts": {
    "esbuild@0.25.0": true
  },
  "dependencies": {
    "js-yaml": "^4.1.1"
  }
}
